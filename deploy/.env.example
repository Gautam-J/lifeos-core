# Settings and secrets for deploy/. Copy to deploy/.env and fill in the values:
#   cp .env.example .env && chmod 600 .env
# deploy/.env is not in git. Generate a password with: openssl rand -hex 24
# The server needs only the two database passwords and the two values of
# Cloudflare Access for the MCP server. For each other key that you add
# here, add its name to UnsetEnvironment in systemd/lifeos.service.

# Postgres (docker-compose.yml): password of the lifeos database user.
POSTGRES_PASSWORD=
# Postgres (query-user.sh, lifeos serve): password of the read-only user
# lifeos_query, for the query tool. `make query-user` makes the user.
LIFEOS_QUERY_PASSWORD=

# restic (backup.sh, restore-test.sh): one password for the local and the B2
# repository. Keep a copy off the Pi; without it the backups cannot be read.
RESTIC_PASSWORD=

# Backblaze B2 (backup.sh, restore-test.sh): the bucket, its S3 endpoint from
# the bucket page, and an application key limited to that bucket. restic reads
# the AWS_ names.
B2_BUCKET=
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare API: only for one-time setup of Access applications. No file in
# deploy/ reads these; leave them empty when no setup is in progress.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Access (lifeos serve): the MCP server answers only a request
# that has a token of the Access application of the MCP hostname. The team
# name is the first part of <team>.cloudflareaccess.com. The audience tag
# is on the page of the application in the Cloudflare dashboard. The server
# does not start without the two values. They are not secrets, but they
# name the Cloudflare account.
CF_ACCESS_TEAM=
LIFEOS_MCP_AUD=

# Public hostnames of LifeOS (check-access.sh): the admin pages, the REST
# API, the MCP server and Grafana, each behind its own Cloudflare Access
# application.
# Leave them empty when LifeOS has no public hostname.
LIFEOS_ADMIN_HOST=
LIFEOS_API_HOST=
LIFEOS_MCP_HOST=
# The dashboards (Grafana): Access is the one login, Grafana has none.
LIFEOS_DASH_HOST=
# The Claude Code telemetry (the OTel collector). The OTel hostname has no
# Access application; the collector checks the bearer token
# OTEL_BEARER_TOKEN.
LIFEOS_OTEL_HOST=
# Cloudflare Access service token of the Pi (check-access.sh): lets the check
# call the API and the MCP server through the tunnel. The Access application
# of each of the two must have a policy that accepts this token. Leave them
# empty to skip that part.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ntfy (docker-compose.yml): public URL of the ntfy server.
NTFY_BASE_URL=https://ntfy.example.com
# ntfy (notify.sh): access token of the write-only publisher user. Create it with:
#   docker compose exec ntfy ntfy token add <user>
NTFY_TOKEN=

# Grafana (docker-compose.yml): password of the built-in user admin. Grafana
# has no login form (Access is the one login), so no person types it. It
# replaces the default password "admin". Grafana reads it only at the first
# start.
GRAFANA_ADMIN_PASSWORD=

# OTel collector (docker-compose.yml): the bearer token of the Claude Code
# telemetry. Each client sends it as OTEL_EXPORTER_OTLP_HEADERS
# "Authorization=Bearer <token>" in ~/.claude/settings.json. Make it with:
#   openssl rand -hex 32
OTEL_BEARER_TOKEN=
