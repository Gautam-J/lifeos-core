package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

// habitsView is what the habits page shows below its form.
type habitsView struct {
	Today  service.HabitChecklist
	Habits []service.Habit
	Logs   []service.HabitLog
}

templ habitsPage(view habitsView) {
	@page("Habits", "Habits") {
		<header class="page-head">
			<h1>Habits</h1>
			<p>A habit has one log for each day.</p>
		</header>
		<section class="panel" aria-label="Add a habit">
			<form class="form" hx-post="/admin/habits" hx-target="#list" hx-swap="outerHTML" hx-on:habit-added="this.reset()">
				<label class="field field-wide">
					New habit
					<input type="text" name="name" required maxlength="50"/>
				</label>
				<button class="btn btn-primary" type="submit">Add habit</button>
			</form>
		</section>
		@habitsList(view, "")
	}
}

// habitsList is the part of the page that a form post replaces.
templ habitsList(view habitsView, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		<div class="section-head">
			<h2 class="serif-sm">Today</h2>
			<time class="muted small" datetime={ view.Today.Date }>{ longDay(view.Today.Date) }</time>
		</div>
		if len(view.Today.Habits) == 0 {
			<p class="empty">No active habit.</p>
		} else {
			<div class="card">
				<ul class="rows">
					for _, habit := range view.Today.Habits {
						<li>
							<span class="row-main">{ habit.Name }</span>
							if habit.Done {
								<span class="state"><span class="dot dot-yes"></span>done</span>
							} else {
								<form class="inline-form" hx-post="/admin/habits/log" hx-target="#list" hx-swap="outerHTML">
									<span class="state muted small"><span class="dot dot-no"></span>not done</span>
									<input type="hidden" name="habit" value={ habit.Name }/>
									<button class="btn btn-sm btn-secondary" type="submit">Log</button>
								</form>
							}
						</li>
					}
				</ul>
			</div>
		}
		<div class="section-head">
			<h2 class="serif-sm">All habits</h2>
		</div>
		if len(view.Habits) == 0 {
			<p class="empty">No habits yet. Add the first one with the form.</p>
		} else {
			<div class="panel">
				<ul class="rows">
					for _, habit := range view.Habits {
						<li>
							<form class="inline-form row-form" hx-post={ habitPath(habit.ID) } hx-target="#list" hx-swap="outerHTML">
								<span class="id">{ strconv.FormatInt(habit.ID, 10) }</span>
								<input type="text" name="name" required maxlength="50" aria-label="Name" value={ habit.Name }/>
								<label class="check">
									<input type="checkbox" name="active" value="true" checked?={ habit.Active }/>
									active
								</label>
								<button class="btn btn-sm btn-secondary" type="submit">Save</button>
							</form>
						</li>
					}
				</ul>
			</div>
		}
		<div class="section-head">
			<h2 class="serif-sm">Logs</h2>
		</div>
		if len(view.Logs) == 0 {
			<p class="empty">No logs yet.</p>
		} else {
			<div class="table-wrap">
				<table class="cards">
					<thead>
						<tr>
							<th>ID</th>
							<th>Habit</th>
							<th>Day</th>
							<th class="col-lo">Source</th>
							<th>From</th>
							<th class="col-lo">Logged</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, log := range view.Logs {
							<tr>
								<td class="id" data-label="ID">{ strconv.FormatInt(log.ID, 10) }</td>
								<td class="title">{ log.Habit }</td>
								<td class="when" data-label="Day">{ log.LoggedOn }</td>
								<td class="col-lo" data-label="Source">{ string(log.Source) }</td>
								<td data-label="From">
									@journalLink(log.JournalRef)
								</td>
								<td class="when col-lo" data-label="Logged">{ stamp(log.CreatedAt) }</td>
								<td class="cell-actions">
									<div class="actions">
										<button
											class="link link-danger"
											hx-post={ "/admin/habits/logs/" + strconv.FormatInt(log.ID, 10) + "/delete" }
											hx-target="#list"
											hx-swap="outerHTML"
											hx-confirm={ "Delete the log of " + log.Habit + " on " + log.LoggedOn + "?" }
										>Delete</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func habitPath(id int64) string {
	return "/admin/habits/" + strconv.FormatInt(id, 10)
}
