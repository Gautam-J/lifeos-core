package admin

// dayField is the field of a day. The text is DD-MM-YYYY in each browser: a
// date input shows the day in the format of the system, which can be
// MM-DD-YYYY (#50). The button opens the calendar of the browser (day.js).
// value is a day as YYYY-MM-DD or what Gautam typed. max is the last day
// that the calendar offers, as YYYY-MM-DD, or empty. label names a field
// that has no label around it.
templ dayField(name, value, max, label string, required bool) {
	<span class="day-field">
		<input
			type="text"
			class="day"
			name={ name }
			value={ dayOut(value) }
			inputmode="numeric"
			autocomplete="off"
			maxlength="10"
			placeholder="DD-MM-YYYY"
			pattern="[0-9]{2}-[0-9]{2}-[0-9]{4}"
			title="A day as DD-MM-YYYY"
			required?={ required }
			if max != "" {
				data-max={ max }
			}
			if label != "" {
				aria-label={ label }
			}
		/>
		<button class="day-pick" type="button" aria-label="Pick a day">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg>
		</button>
	</span>
}
