package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

templ sourcesPage(captures []service.Capture) {
	@page("Sources", "Sources") {
		<header class="page-head">
			<h1>Sources</h1>
			<p>A source is a text or a link that LifeOS keeps exactly as it is. Fill in the text or the link, not the two.</p>
		</header>
		<section class="panel" aria-label="Capture a source">
			<form class="form" hx-post="/admin/sources" hx-target="#list" hx-swap="outerHTML" hx-on:source-added="this.reset()">
				<label class="field field-full">
					Text
					<textarea name="text" rows="6"></textarea>
				</label>
				<label class="field field-wide">
					Link
					<input type="url" name="url" placeholder="https://"/>
				</label>
				<label class="field field-wide">
					<span>Title <span class="hint">(optional)</span></span>
					<input type="text" name="title" maxlength="300"/>
				</label>
				<button class="btn btn-primary" type="submit">Capture source</button>
			</form>
		</section>
		@sourcesList(captures, "")
	}
}

// sourcesList is the part of the page that a form post replaces.
templ sourcesList(captures []service.Capture, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		if len(captures) == 0 {
			<p class="empty">No sources yet. Capture the first one with the form.</p>
		} else {
			<div class="table-wrap">
				<table class="cards">
					<thead>
						<tr>
							<th>ID</th>
							<th>Kind</th>
							<th>Title</th>
							<th>Content</th>
							<th class="col-lo">Source</th>
							<th>Captured</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, capture := range captures {
							<tr>
								<td class="id" data-label="ID">{ strconv.FormatInt(capture.ID, 10) }</td>
								<td><span class="pill">{ capture.Kind }</span></td>
								<td class="title">{ capture.Title }</td>
								<td class="wrap-any" data-label="Content">
									switch capture.Kind {
										case "link":
											<a href={ templ.URL(capture.URL) } rel="noreferrer">{ capture.URL }</a>
										case "file":
											{ capture.MediaType }, { fileSize(capture.SizeBytes) }
										default:
											{ preview(capture.Content) }
									}
								</td>
								<td class="col-lo" data-label="Source">{ string(capture.Source) }</td>
								<td class="when" data-label="Captured">{ stamp(capture.CreatedAt) }</td>
								<td class="cell-actions">
									<div class="actions">
										<a class="link" href={ templ.URL(sourcePath(capture.ID)) }>View</a>
										<button
											class="link link-danger"
											hx-post={ sourcePath(capture.ID) + "/delete" }
											hx-target="#list"
											hx-swap="outerHTML"
											hx-confirm={ "Delete source " + strconv.FormatInt(capture.ID, 10) + "?" }
										>Delete</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func sourcePath(id int64) string {
	return "/admin/sources/" + strconv.FormatInt(id, 10)
}

// sourceDetailPage shows one source whole: the list cuts a long text. A
// source is verbatim (rule 12), so the page has no form to change it.
templ sourceDetailPage(capture service.Capture) {
	@page("Source "+strconv.FormatInt(capture.ID, 10), "Sources") {
		<header class="page-head">
			<h1>Source { strconv.FormatInt(capture.ID, 10) }</h1>
			<p>A source stays exactly as it was captured, so it has no edit.</p>
		</header>
		<section class="panel panel-narrow">
			<dl class="facts">
				<dt>Kind</dt>
				<dd>{ capture.Kind }</dd>
				if capture.Title != "" {
					<dt>Title</dt>
					<dd>{ capture.Title }</dd>
				}
				<dt>From</dt>
				<dd>{ string(capture.Source) }</dd>
				<dt>Captured</dt>
				<dd>{ stamp(capture.CreatedAt) }</dd>
				if capture.ProcessedAt != nil {
					<dt>Processed</dt>
					<dd>{ stamp(*capture.ProcessedAt) }</dd>
				}
				if capture.Kind == "file" {
					<dt>File</dt>
					<dd>{ capture.MediaType }, { fileSize(capture.SizeBytes) }</dd>
				}
				<dt>SHA-256</dt>
				<dd class="wrap-any">{ capture.SHA256 }</dd>
			</dl>
			switch capture.Kind {
				case "link":
					<p class="wrap-any"><a href={ templ.URL(capture.URL) } rel="noreferrer">{ capture.URL }</a></p>
				case "text":
					<div class="prose">{ capture.Content }</div>
			}
			<p><a class="link" href="/admin/sources">All sources</a></p>
		</section>
	}
}
