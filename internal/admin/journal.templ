package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

templ journalPage(entries []service.JournalEntry) {
	@page("Journal", "Journal") {
		<header class="page-head">
			<h1>Journal</h1>
			<p>Your own words, stored exactly as you write them.</p>
		</header>
		<section class="panel" aria-label="Write an entry">
			<form class="form" hx-post="/admin/journal" hx-target="#list" hx-swap="outerHTML" hx-on:entry-added="this.reset()">
				<label class="field field-full">
					Entry
					<textarea name="body" required rows="6"></textarea>
				</label>
				<label class="field">
					<span>Day <span class="hint">(empty means today)</span></span>
					<input type="date" name="entry_date"/>
				</label>
				<button class="btn btn-primary" type="submit">Add entry</button>
			</form>
		</section>
		@journalList(entries, "")
	}
}

// journalList is the part of the page that a form post replaces.
templ journalList(entries []service.JournalEntry, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		if len(entries) == 0 {
			<p class="empty">No entries yet. Write the first one with the form.</p>
		} else {
			<div class="entries">
				for _, entry := range entries {
					<article class="entry">
						<div class="entry-head">
							<h2 class="entry-day"><time datetime={ entry.EntryDate }>{ longDay(entry.EntryDate) }</time></h2>
							<span class="id">entry { strconv.FormatInt(entry.ID, 10) }</span>
						</div>
						<div class="prose">{ entry.Body }</div>
						<div class="entry-foot">
							<span class="meta">
								<span>{ string(entry.Source) }</span>
								<span>Written { stamp(entry.CreatedAt) }</span>
							</span>
							<div class="actions">
								<a class="link" href={ templ.URL(journalPath(entry.ID) + "/edit") }>Edit</a>
								<button
									class="link link-danger"
									hx-post={ journalPath(entry.ID) + "/delete" }
									hx-target="#list"
									hx-swap="outerHTML"
									hx-confirm={ "Delete the entry of " + entry.EntryDate + "?" }
								>Delete</button>
							</div>
						</div>
					</article>
				}
			</div>
		}
	</div>
}

// journalForm holds the values of the edit form as text. When the service
// refuses a value, the form shows again what Gautam typed.
type journalForm struct {
	ID        int64
	Body      string
	EntryDate string
}

// The text area starts with a line break, because a browser drops one line
// break after the start tag. Without it, an entry that starts with a line
// break loses that line break on Save.
templ editJournalPage(form journalForm, errorMessage string) {
	@page("Edit journal entry", "Journal") {
		<header class="page-head">
			<h1>Edit journal entry { strconv.FormatInt(form.ID, 10) }</h1>
		</header>
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		<section class="panel panel-narrow">
			<form class="form form-stack" method="post" action={ templ.URL(journalPath(form.ID)) }>
				<label class="field">
					Entry
					<textarea name="body" required rows="12">{ "\n" + form.Body }</textarea>
				</label>
				<label class="field">
					Day
					<input type="date" name="entry_date" required value={ form.EntryDate }/>
				</label>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Save changes</button>
					<a class="btn btn-secondary" href="/admin/journal">Cancel</a>
				</div>
			</form>
		</section>
	}
}

func journalPath(id int64) string {
	return "/admin/journal/" + strconv.FormatInt(id, 10)
}

// journalLink shows the journal entry that a record comes from, as
// journal:57, linked to the entry. It shows nothing for 0.
templ journalLink(ref int64) {
	if ref != 0 {
		<a href={ templ.URL(journalPath(ref) + "/edit") }>{ "journal:" + strconv.FormatInt(ref, 10) }</a>
	}
}
