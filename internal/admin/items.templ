package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

templ itemsPage(items []service.Item) {
	@page("Items", "Items") {
		<header class="page-head">
			<h1>Items</h1>
			<p>What you watched, read, visited or played, with your rating.</p>
		</header>
		<section class="panel" aria-label="Add an item">
			<form class="form" hx-post="/admin/items" hx-target="#list" hx-swap="outerHTML" hx-on:item-added="this.reset()">
				<label class="field field-narrow">
					Kind
					<select name="kind" required>
						for _, kind := range service.ItemKinds {
							<option value={ kind }>{ kind }</option>
						}
					</select>
				</label>
				<label class="field field-wide">
					Title
					<input type="text" name="title" required maxlength="300"/>
				</label>
				<label class="field field-narrow">
					Rating
					<input type="number" name="rating" min="0" max="5" step="0.5" inputmode="decimal" placeholder="0 to 5"/>
				</label>
				<label class="field">
					Date
					<input type="date" name="occurred_on"/>
				</label>
				<button class="btn btn-primary" type="submit">Add item</button>
			</form>
		</section>
		@itemsList(items, "")
	}
}

// itemsList is the part of the page that a form post replaces.
templ itemsList(items []service.Item, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		if len(items) == 0 {
			<p class="empty">No items yet. Add the first one with the form.</p>
		} else {
			<div class="table-wrap">
				<table class="cards">
					<thead>
						<tr>
							<th>ID</th>
							<th>Title</th>
							<th>Kind</th>
							<th>Rating</th>
							<th>Date</th>
							<th class="col-lo">Source</th>
							<th>Verified</th>
							<th class="col-lo">Added</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td class="id" data-label="ID">{ strconv.FormatInt(item.ID, 10) }</td>
								<td class="title">{ item.Title }</td>
								<td><span class="pill">{ item.Kind }</span></td>
								<td class="num" data-label="Rating">{ formatRating(item.Rating) }</td>
								<td class="when" data-label="Date">{ item.OccurredOn }</td>
								<td class="col-lo" data-label="Source">{ string(item.Source) }</td>
								<td data-label="Verified">
									@yesNo(item.Verified)
								</td>
								<td class="when col-lo" data-label="Added">{ stamp(item.CreatedAt) }</td>
								<td class="cell-actions">
									<div class="actions">
										<a class="link" href={ templ.URL(itemPath(item.ID) + "/edit") }>Edit</a>
										<button
											class="link link-danger"
											hx-post={ itemPath(item.ID) + "/delete" }
											hx-target="#list"
											hx-swap="outerHTML"
											hx-confirm={ "Delete " + item.Title + "?" }
										>Delete</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// yesNo shows the verified column of a list.
templ yesNo(verified bool) {
	if verified {
		<span class="state"><span class="dot dot-yes"></span>yes</span>
	} else {
		<span class="state"><span class="dot dot-no"></span>no</span>
	}
}

// itemsFailure takes the place of the list when a form post fails on the
// server.
templ itemsFailure(message string) {
	<div id="list">
		<p class="error" role="alert">{ message }</p>
	</div>
}

// itemForm holds the values of the edit form as text. When the service
// refuses a value, the form shows again what Gautam typed.
type itemForm struct {
	ID         int64
	Kind       string
	Title      string
	Rating     string
	OccurredOn string
}

templ editItemPage(form itemForm, errorMessage string) {
	@page("Edit item", "Items") {
		<header class="page-head">
			<h1>Edit item { strconv.FormatInt(form.ID, 10) }</h1>
		</header>
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		<section class="panel panel-narrow">
			<form class="form form-stack" method="post" action={ templ.URL(itemPath(form.ID)) }>
				<label class="field">
					Kind
					<select name="kind" required>
						for _, kind := range service.ItemKinds {
							<option value={ kind } selected?={ kind == form.Kind }>{ kind }</option>
						}
					</select>
				</label>
				<label class="field">
					Title
					<input type="text" name="title" required maxlength="300" value={ form.Title }/>
				</label>
				<label class="field">
					Rating
					<input type="number" name="rating" min="0" max="5" step="0.5" inputmode="decimal" value={ form.Rating }/>
				</label>
				<label class="field">
					Date
					<input type="date" name="occurred_on" value={ form.OccurredOn }/>
				</label>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Save changes</button>
					<a class="btn btn-secondary" href="/admin/items">Cancel</a>
				</div>
			</form>
		</section>
	}
}

func itemPath(id int64) string {
	return "/admin/items/" + strconv.FormatInt(id, 10)
}

func formatRating(rating *float64) string {
	if rating == nil {
		return ""
	}
	return strconv.FormatFloat(*rating, 'f', -1, 64)
}

func formatVerified(verified bool) string {
	if verified {
		return "yes"
	}
	return "no"
}
