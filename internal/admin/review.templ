package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

templ reviewPage(entries []service.ReviewEntry) {
	@page("Review", "Review") {
		<header class="page-head">
			<h1>Review queue</h1>
			<p>Records that an agent inferred. Reports do not count a record until you approve it.</p>
		</header>
		@reviewList(entries, "")
	}
}

// reviewList is the part of the page that an approval replaces.
templ reviewList(entries []service.ReviewEntry, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		if len(entries) == 0 {
			<p class="empty">No record waits for review.</p>
		} else {
			<div class="table-wrap">
				<table class="cards">
					<thead>
						<tr>
							<th>Type</th>
							<th>ID</th>
							<th>Record</th>
							<th class="col-lo">Source</th>
							<th>Added</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range entries {
							<tr>
								<td><span class="pill">{ entry.Type }</span></td>
								<td class="id" data-label="ID">{ strconv.FormatInt(entry.ID, 10) }</td>
								<td class="title">{ entry.Summary }</td>
								<td class="col-lo" data-label="Source">{ string(entry.Source) }</td>
								<td class="when" data-label="Added">{ stamp(entry.CreatedAt) }</td>
								<td class="cell-actions">
									<div class="actions">
										<form hx-post="/admin/review/verify" hx-target="#list" hx-swap="outerHTML">
											<input type="hidden" name="type" value={ entry.Type }/>
											<input type="hidden" name="id" value={ strconv.FormatInt(entry.ID, 10) }/>
											<button class="btn btn-sm btn-primary" type="submit">Approve</button>
										</form>
										switch entry.Type {
											case "item":
												<a class="link" href={ templ.URL(itemPath(entry.ID) + "/edit") }>Edit</a>
											case "journal":
												<a class="link" href={ templ.URL(journalPath(entry.ID) + "/edit") }>Edit</a>
											case "todo":
												<a class="link" href={ templ.URL(todoPath(entry.ID) + "/edit") }>Edit</a>
											case "habit_log":
												<a class="link" href="/admin/habits">Habits</a>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
