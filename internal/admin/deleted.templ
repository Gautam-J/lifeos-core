package admin

import (
	"strconv"

	"github.com/Gautam-J/lifeos-core/internal/service"
)

templ deletedPage(records []service.DeletedRecord) {
	@page("Deleted", "Deleted") {
		<header class="page-head">
			<h1>Deleted records</h1>
			<p>A deleted record stays in the database until you remove it here. "Delete forever" removes the record, the content of its history and the file of a file source. You cannot get it back.</p>
		</header>
		@deletedList(records, "")
	}
}

// deletedList is the part of the page that a removal replaces.
templ deletedList(records []service.DeletedRecord, errorMessage string) {
	<div id="list">
		if errorMessage != "" {
			<p class="error" role="alert">{ errorMessage }</p>
		}
		if len(records) == 0 {
			<p class="empty">No record is deleted.</p>
		} else {
			<div class="table-wrap">
				<table class="cards">
					<thead>
						<tr>
							<th>Type</th>
							<th>ID</th>
							<th>Record</th>
							<th>Deleted</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, record := range records {
							<tr>
								<td><span class="pill">{ record.Type }</span></td>
								<td class="id" data-label="ID">{ strconv.FormatInt(record.ID, 10) }</td>
								<td class="title">{ record.Summary }</td>
								<td class="when" data-label="Deleted">{ stamp(record.DeletedAt) }</td>
								<td class="cell-actions">
									<div class="actions">
										<form
											hx-post="/admin/deleted/purge"
											hx-target="#list"
											hx-swap="outerHTML"
											hx-confirm={ "Delete " + record.Type + " " + strconv.FormatInt(record.ID, 10) + " forever? You cannot get it back." }
										>
											<input type="hidden" name="type" value={ record.Type }/>
											<input type="hidden" name="id" value={ strconv.FormatInt(record.ID, 10) }/>
											<button class="link link-danger" type="submit">Delete forever</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
